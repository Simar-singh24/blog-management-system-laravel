APP_NAME="Blog Dashboard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR_SERVICE.onrender.com

LOG_CHANNEL=stack

# Use a managed Postgres on Render
DATABASE_URL=postgres://user:pass@host:5432/dbname

FILESYSTEM_DISK=public
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Mail (configure if you need outgoing email)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@yourdomain.com
MAIL_FROM_NAME="Blog Dashboard"

# Do NOT use sqlite in production on Render (filesystem is ephemeral)
# AWS / S3 settings (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
